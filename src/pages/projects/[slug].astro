---
import "../../styles/global.css";
import { projects } from "../../data/projects";
import ProjectMarkdown from "../../content/projects/project-markdown.md";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";

export function getStaticPaths() {
return projects.map((project) => ({
params: { slug: project.slug },
props: { project },
}));
}

const { project } = Astro.props;
---

<html lang="en">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width"/>
    <title>{project.title}</title>
</head>

<body>

<Nav/>

<main class="page">
    <article class="project-page">
        <div class="project-page-header">
            <div class="project-eyebrow">
                <p class="eyebrow">Tanya Abramovskaia</p>
            </div>
            <h1>{project.title}</h1>

            <p class="project-page-description">
                {project.description}
            </p>

            <div class="tags project-page-tags">
                {project.tags.map((tag) => (
                <span>{tag}</span>
                ))}
            <a href="https://github.com/TAbramovskaya/" aria-label="GitHub" class="project-github-link">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path fill="currentColor" d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56v-2.17c-3.2.7-3.88-1.36-3.88-1.36-.53-1.33-1.28-1.69-1.28-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.75 2.67 1.24 3.32.95.1-.74.4-1.24.73-1.53-2.55-.29-5.23-1.28-5.23-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.47.11-3.06 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23 2.77.11 3.06.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.4-5.25 5.69.41.35.78 1.04.78 2.1v3.12c0 .31.21.68.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/>
                    </svg>
                </a>
            </div>

        </div>

        <div class="project-page-image">
            <img
                    src={project.image}
                    alt={project.title}
            />
        </div>
        <div class="project-markdown">
            <ProjectMarkdown/>
        </div>

    </article>
</main>
<Footer/>
</body>
</html>